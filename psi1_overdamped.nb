Notebook[{
Cell["Overdamped Brownian motion", "WolframAlphaShort",
 CellChangeTimes->{{3.894823377257225*^9, 3.89482338167267*^9}, {
  3.927351522354868*^9, 
  3.927351526247057*^9}},ExpressionUUID->"bcc0ea5f-ec21-4e7f-bb80-\
5b714bbb0c6e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Tau]", ">", "0"}], ",", 
     RowBox[{"\[Tau]R", ">", "0"}], ",", 
     RowBox[{"\[Omega]", ">", "0"}], ",", 
     RowBox[{
      RowBox[{"\[Tau]R", " ", 
       RowBox[{"Re", "[", "s", "]"}]}], ">", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"t", ">=", "0"}], ",", 
     RowBox[{
      RowBox[{"\[Tau]", "-", "t"}], ">=", "0"}]}], "}"}]}], ";"}]], "Input",Ex\
pressionUUID->"be431d04-cd78-4194-a145-613c03b654fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Psi", "[", "t_", "]"}], "=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Abs", "[", "t", "]"}]}], "/", "\[Tau]R"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dPsi", "[", "t_", "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Sign", "[", "t", "]"}]}], 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Abs", "[", "t", "]"}]}], "/", "\[Tau]R"}], "]"}], "/", 
     "\[Tau]R"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ddPsi1", "[", "t_", "]"}], "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Abs", "[", "t", "]"}]}], "/", "\[Tau]R"}], "]"}], "/", 
    SuperscriptBox["\[Tau]R", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ddPsi2", "[", "t_", "]"}], "=", 
   RowBox[{
    RowBox[{"-", "2"}], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Abs", "[", "t", "]"}]}], "/", "\[Tau]R"}], "]"}], 
    RowBox[{
     RowBox[{"DiracDelta", "[", "t", "]"}], "/", "\[Tau]R"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.8917527312176647`*^9, 3.8917527991129*^9}, {
  3.89175345670229*^9, 3.891753471178212*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"ee55ec22-ee77-49f1-bd49-8ddf0c0f594c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lt1", "[", "s_", "]"}], "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ddPsi1", "[", "t", "]"}], 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "s"}], " ", "t"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "Infinity"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lt2", "[", "s_", "]"}], "=", 
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ddPsi2", "[", "t", "]"}], 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "s"}], " ", "t"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "Infinity"}], "}"}]}], "]"}], "/.", 
   RowBox[{
    RowBox[{"HeavisideTheta", "[", "0", "]"}], "->", 
    RowBox[{"1", "/", "2"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.891752816650714*^9, 3.8917528827838287`*^9}, {
   3.8917534752892723`*^9, 3.8917535046447687`*^9}, {3.8917536801432133`*^9, 
   3.891753688259409*^9}, {3.89175376196033*^9, 3.8917537647588*^9}, {
   3.891753796045937*^9, 3.891753797683814*^9}, {3.891762456817234*^9, 
   3.89176246230272*^9}, 3.8917625385149117`*^9, {3.8917628197411947`*^9, 
   3.891762873255598*^9}, {3.89176319342478*^9, 3.891763197499867*^9}, {
   3.891763580408264*^9, 3.8917635863922453`*^9}, {3.891763772597336*^9, 
   3.891763776016884*^9}, 3.891764230177465*^9, {3.8917701414379387`*^9, 
   3.891770152237039*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"dd19fb5c-210c-4edd-a322-6e66c213a35e"],

Cell[BoxData[
 FractionBox["1", 
  RowBox[{"\[Tau]R", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"s", " ", "\[Tau]R"}]}], ")"}]}]]], "Output",
 CellChangeTimes->{{3.894823501207745*^9, 3.8948235349409246`*^9}, 
   3.8948631423435783`*^9, 3.894863216745946*^9, {3.8948635806845922`*^9, 
   3.8948635877239923`*^9}, {3.894868377335853*^9, 3.894868383203397*^9}, {
