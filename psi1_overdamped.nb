}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "s_", "]"}], "=", 
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"s", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"lt1", "[", "s", "]"}], "+", 
         RowBox[{"lt2", "[", "s", "]"}]}], ")"}]}]]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c0", "=", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{
      RowBox[{"f", "[", "s", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c1", "=", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{
      RowBox[{"f", "[", "s", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c2", "=", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{
     RowBox[{"f", "[", "s", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.894823458122789*^9, 3.894823483405212*^9}, 
   3.89482360754362*^9, 3.894863184847007*^9, {3.894863222116063*^9, 
   3.894863224258157*^9}, {3.907913458462442*^9, 3.907913460105482*^9}, {
   3.907913536577758*^9, 3.907913560414969*^9}, {3.927182645280039*^9, 
   3.927182652046432*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"215a0c14-9a30-4d10-a6b0-757b6210397c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "t_", "]"}], "=", 
   FractionBox[
    RowBox[{"t", "+", "\[Tau]R"}], 
    RowBox[{"\[Tau]", "+", 
     RowBox[{"2", "\[Tau]R"}]}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"W0", "[", "\[Tau]_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"Psi", "[", "0", "]"}], "2"], "+", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dPsi", "[", 
         RowBox[{"\[Tau]", "-", "t"}], "]"}], 
        RowBox[{"g", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "\[Tau]"}], "}"}]}], "]"}]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.927006220035327*^9, 3.9270062501357327`*^9}, 
   3.927006978025477*^9, {3.927015077915989*^9, 3.927015078219699*^9}, {
